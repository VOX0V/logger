# Copie ce fichier en .env (jamais committé). Aucune valeur de démonstration n'est acceptée : l'application refuse de démarrer.

# --- Premier administrateur ---------------------------------------------------------------
# Utilisé UNIQUEMENT si aucun compte n'existe encore. 15 caractères minimum (une phrase de passe convient).
# Alternative sans mot de passe dans un fichier : laisse ADMIN_PASSWORD vide et lance
#     docker compose run --rm logger python manage.py init-admin
# Retire ADMIN_PASSWORD de ce fichier une fois le compte créé.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Clé de signature des sessions ---------------------------------------------------------
# Laisse VIDE : une clé aléatoire est générée et conservée dans le volume (appdata/.secret_key, droits 0600).
# Si tu en fournis une : 32 caractères minimum, aléatoire (python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=

# --- Réseau --------------------------------------------------------------------------------
# Adresse/port publiés sur l'hôte. 127.0.0.1 = accessible seulement depuis la machine (reverse proxy local).
LOGGER_BIND=127.0.0.1
LOGGER_PORT=8000
# Nombre de reverse proxies de confiance devant l'application (0 = aucun : les en-têtes X-Forwarded-* sont ignorés).
TRUSTED_PROXIES=0
# Cookie de session réservé à HTTPS. Ne mets 0 que sur un réseau local de confiance sans HTTPS.
COOKIE_SECURE=1
# Active Strict-Transport-Security (uniquement si le site est servi en HTTPS de façon permanente).
HSTS_ENABLED=0

# --- Sessions, limites, journal (valeurs par défaut) -----------------------------------------
# SESSION_IDLE_MINUTES=60
# SESSION_ABSOLUTE_HOURS=12
# REAUTH_MINUTES=10
# MAX_UPLOAD_MB=50
# SECURITY_LOG_RETENTION_DAYS=180
# CSP_REPORT_ONLY=0     # 1 = la CSP signale sans bloquer (dépannage uniquement)
